---
import LayoutBasic from '@/layouts/LayoutBasic.astro';
---

<LayoutBasic>
	<section class="bg-white">
		<h3>시설 상세</h3>

		<ul class="flex flex-col divide-y divide-slate-200">
			<li>
				<header class="flex items-center justify-between">
					<h4>기본 정보</h4>
					<ui-btn variant="ghost" size="sm" cls="min-w-15" txt="수정"></ui-btn>
				</header>
				<div>
					<lang-translate data-max-length="50" view="detail"></lang-translate>
				</div>
			</li>
		</ul>
	</section>
</LayoutBasic>

<alert-popup class="fixed top-0 left-0" txt="" confirm="확인" cancel="취소" open="close"></alert-popup>
